# --------------------------------------------------------------------------
# Application
# --------------------------------------------------------------------------
APP_NAME=ServiceDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# Local: SQLite (database/database.sqlite). Production (Plesk): MariaDB.
# --------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=servicedesk
# DB_USERNAME=servicedesk
# DB_PASSWORD=

# --------------------------------------------------------------------------
# Session, cache and queue (Plesk: no Redis, no Supervisor)
# The queue is processed by the scheduler (cron: php artisan schedule:run).
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
# Max. size per attachment in KB (PHP upload_max_filesize must allow it)
ATTACHMENT_MAX_KB=20480

# --------------------------------------------------------------------------
# System mail (password resets, notifications)
# Ticket mail is sent through the SMTP account of each mailbox (configured
# in the admin area, not here).
# Local: "log" writes mails to storage/logs.
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="servicedesk@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ticket mail (mailboxes are configured in the admin area)
MAIL_FETCH_LIMIT=25
TICKET_REOPEN_DAYS=14

# --------------------------------------------------------------------------
# Local development only: admin account created by `php artisan db:seed`
# (ignored outside APP_ENV=local)
# --------------------------------------------------------------------------
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=admin@servicedesk.test
SEED_ADMIN_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
